# =============================================================================
# Kemo LLM Adapter — Provider API Keys (示例模板)
# =============================================================================
# 将本文件复制为 provider.env，填入真实的 API 密钥后启动。
#   cp provider.env.example provider.env
# =============================================================================

# ---- Kemo Adapter public display URL ----
# 仅用于管理面板右上角展示，方便内网穿透后的用户复制 base_url。
# 不参与本地 API 绑定、请求路由或 provider 调用。
BASE_URL=127.0.0.1:8741

# ---- 管理员账户 ----
# 管理面板登录凭证，修改后重启服务生效。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- Chat concurrency admission control ----
# 修改后重启服务生效。全局与单 Provider 限制同时满足时请求才会进入上游。
KEMO_CHAT_GLOBAL_CONCURRENCY=32
KEMO_CHAT_PROVIDER_CONCURRENCY=16
KEMO_CHAT_QUEUE_TIMEOUT=10

# 仅在上游尚未返回任何 chunk 时重试 ConnectError/ConnectTimeout。
KEMO_CONNECT_RETRIES=2

# ---- 更多厂商按此格式添加 ----
# 规则：model.json 里 api_key_env 填什么，这里就用什么。
