# =============================================================================
# Kemo LLM Adapter — Provider API Keys (示例模板)
# =============================================================================
# 将本文件复制为 provider.env，填入真实的 API 密钥后启动。
#   cp provider.env.example provider.env
# =============================================================================

# ---- Kemo Adapter public display URL ----
# 仅用于管理面板右上角展示，方便内网穿透后的用户复制 base_url。
# 不参与本地 API 绑定、请求路由或 provider 调用。
BASE_URL=127.0.0.1:8741

# ---- DeepSeek ----
# 文档: https://api-docs.deepseek.com/
# 注册: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- MiniMax (Mimo) ----
# 文档: https://www.minimax.com/
# MINIMAX_API_KEY=your-minimax-key
# MINIMAX_BASE_URL=https://api.minimax.com

# ---- StepFun (阶跃星辰) ----
# 文档: https://platform.stepfun.com/
# 注册: https://platform.stepfun.com/
# STEPFUN_API_KEY=your-stepfun-api-key
# STEPFUN_BASE_URL=https://api.stepfun.com

# ---- 更多厂商按此格式添加 ----
# 规则：model.json 里 api_key_env 填什么，这里就用什么。
