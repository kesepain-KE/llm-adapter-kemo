# =============================================================================
# Kemo LLM Adapter — Provider API Keys (示例模板)
# =============================================================================
# 将本文件复制为 provider.env，填入真实的 API 密钥后启动。
#   cp provider.env.example provider.env
# =============================================================================

# ---- Kemo Adapter public display URL ----
# 仅用于管理面板右上角展示，方便内网穿透后的用户复制 base_url。
# 不参与本地 API 绑定、请求路由或 provider 调用。
BASE_URL=127.0.0.1:8741

# ---- 管理员账户 ----
# 管理面板登录凭证，修改后重启服务生效。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- 更多厂商按此格式添加 ----
# 规则：model.json 里 api_key_env 填什么，这里就用什么。
