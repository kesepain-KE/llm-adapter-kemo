{
  "provider": "stepfun",
  "enabled": true,
  "base_url": "https://api.stepfun.com",
  "api_key_env": "STEPFUN_API_KEY",
  "modules": {
    "chat": "chat",
    "token_count": "token_count",
    "audio": "audio",
    "image": "image"
  },
  "models": {
    "step-3.7-flash": {
      "capabilities": ["chat", "vision.image"],
      "vendor_model": "step-3.7-flash",
      "endpoint": "/v1/chat/completions",
      "input": ["text", "image", "video"],
      "output": ["text"],
      "supports_stream": true,
      "supports_tools": true,
      "supports_json_output": true,
      "supports_thinking": true,
      "supports_reasoning": true,
      "modalities": ["text", "image", "video"]
    },
    "step-3.5-flash-2603": {
      "capabilities": ["chat"],
      "vendor_model": "step-3.5-flash-2603",
      "endpoint": "/step_plan/v1/chat/completions",
      "input": ["text"],
      "output": ["text"],
      "supports_stream": true,
      "supports_tools": true,
      "supports_json_output": true,
      "supports_thinking": true,
      "modalities": ["text"]
    },
    "step-3.5-flash": {
      "capabilities": ["chat"],
      "vendor_model": "step-3.5-flash",
      "endpoint": "/step_plan/v1/chat/completions",
      "input": ["text"],
      "output": ["text"],
      "supports_stream": true,
      "supports_tools": true,
      "supports_json_output": true,
      "supports_thinking": true,
      "modalities": ["text"]
    },
    "step-router-v1": {
      "capabilities": ["chat"],
      "vendor_model": "step-router-v1",
      "endpoint": "/step_plan/v1/chat/completions",
      "input": ["text"],
      "output": ["text"],
      "supports_stream": true,
      "supports_tools": true,
      "supports_json_output": false,
      "supports_thinking": false,
      "modalities": ["text"]
    },
    "stepaudio-2.5-tts": {
      "capabilities": ["audio.tts"],
      "vendor_model": "stepaudio-2.5-tts",
      "endpoint": "/v1/audio/speech",
      "input": ["text"],
      "output": ["audio"],
      "supports_stream": false,
      "supports_tools": false,
      "supports_json_output": false,
      "supports_thinking": false
    },
    "stepaudio-2.5-asr": {
      "capabilities": ["audio.asr"],
      "vendor_model": "stepaudio-2.5-asr",
      "endpoint": "/v1/audio/transcriptions",
      "input": ["audio"],
      "output": ["text"],
      "supports_stream": false,
      "supports_tools": false,
      "supports_json_output": false,
      "supports_thinking": false
    },
    "step-image-edit-2": {
      "capabilities": ["image.edit"],
      "vendor_model": "step-image-edit-2",
      "endpoint": "/v1/images/edits",
      "input": ["image", "text"],
      "output": ["image"],
      "supports_stream": false,
      "supports_tools": false,
      "supports_json_output": false,
      "supports_thinking": false
    }
  }
}
